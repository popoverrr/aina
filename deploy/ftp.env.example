# Доступ к хостингу для scripts/deploy-ftp.mjs. Рабочая копия — deploy/ftp.env (в git не попадает).
# Где взять: Plesk → домен → «Учётные записи FTP» → учётная запись → «Показать»/«Создать» пароль.

FTP_HOST=visa-navigator.kz
FTP_USER=ainaestate
FTP_PASS=
FTP_REMOTE_DIR=                 # пусто — скрипт сам найдёт корень сайта по index.html/index.php
SITE_URL=https://ainaestate.asia
DIST_DIR=dist                   # папка готовой статической сборки (npm run build:static)
ASSETS_DIR=_next/static/chunks  # хэшированные JS/CSS: только здесь удаляются файлы прошлых сборок
PROTECT=                        # через запятую: что на сервере не трогать никогда
CHECK_PATHS=/,/objects,/cases,/about,/owners,/search,/contacts,/privacy
