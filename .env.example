# ---------- База данных (обязательно) ----------
# PostgreSQL. Для разработки: `npm run db:local` поднимает локальный сервер и печатает строку ниже.
# Прод: Neon / Supabase — строка из панели провайдера (с ?sslmode=require).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/ayna"

# ---------- Админка (обязательно) ----------
# Секрет для подписи JWT-сессии: `npx auth secret` или `openssl rand -base64 32`
AUTH_SECRET=
# Логин единственного администратора
ADMIN_EMAIL=
# bcrypt-хеш пароля, генерится скриптом: npm run hash-password -- "пароль"
# ВАЖНО: Next.js раскрывает $ИМЯ в .env-файлах, а в хеше три символа $. Каждый $ нужно
# экранировать как \$ — скрипт печатает уже готовую строку. В панели Vercel вставляйте хеш как есть.
# Пример: ADMIN_PASSWORD_HASH="\$2b\$12\$abc..."
ADMIN_PASSWORD_HASH=

# ---------- Хранилище фото ----------
# Токен Vercel Blob (Storage → Blob → вкладка .env.local). Без него в development фото
# сохраняются в public/uploads, в production загрузка отключена.
BLOB_READ_WRITE_TOKEN=

# ---------- Уведомления о заявках (необязательно) ----------
# Без токена уведомления просто отключены, заявки всё равно пишутся в базу.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Google Sheets (необязательно) ----------
# ID таблицы из URL и сервисный аккаунт с правом редактора на эту таблицу.
# Приватный ключ — одной строкой, переводы строк как \n (как в JSON-файле ключа).
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ---------- Аналитика (необязательно) ----------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_METRIKA_ID=

# ---------- Публичный адрес сайта ----------
# Используется для canonical, sitemap, OpenGraph. Локально — http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
